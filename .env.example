# =============================================================================
# Strategy Engine — environment reference
#
# Two groups: VITE_* values are baked into the browser bundle at build time
# (public, never secrets); everything else is an edge-function secret set with
# `supabase secrets set` (deploy/README.md). Nothing has a hard-coded fallback:
# an unset optional value turns its feature off.
# =============================================================================

# ── Frontend (build-time, public) ────────────────────────────────────────────

# REQUIRED. Your Supabase project URL: Settings > API > Project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
# REQUIRED. Your Supabase anon (publishable) key: Settings > API.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OPTIONAL. Intelligence Engine bolt-on (Tools tab). Unset = tab hidden.
# VITE_NERA_ENGINE_URL=https://your-engine.example.com
# OPTIONAL. Route engine reads through the st-catalogue function (needed when
# the engine is key-gated). "true" also counts as "engine configured".
# VITE_CATALOGUE_VIA_PROXY=true

# OPTIONAL. Website-era Nera chat endpoint; defaults to
# ${VITE_SUPABASE_URL}/functions/v1/nera-query when unset.
# VITE_NERA_API_URL=https://your-project.supabase.co/functions/v1/nera-query
# OPTIONAL. Public bucket base for decision-tree screenshots; defaults to
# ${VITE_SUPABASE_URL}/storage/v1/object/public/content-images when unset.
# VITE_CONTENT_IMAGES_BASE=https://your-project.supabase.co/storage/v1/object/public/content-images

# ── Brand (client/src/lib/brand.ts) — all optional, MTMOT Strategy Engine
# defaults apply when unset. No host map: one build, one brand, from these.
# VITE_BRAND_PRODUCT_NAME=Your Consultancy Strategy Engine
# VITE_BRAND_SHORT_NAME=Strategy Engine
# VITE_BRAND_TITLE=Your Consultancy Strategy Engine
# VITE_BRAND_DESCRIPTION=A conversational evidence platform for board-level strategic engagements.
# VITE_BRAND_LOGO=/images/your-logo.png
# VITE_BRAND_LOGO_ALT=Your Consultancy
# VITE_BRAND_HOME_URL=/
# VITE_BRAND_ACCENT_COLOR=#C9A96E
# VITE_BRAND_SUPPORT_EMAIL=support@example.com
# OPTIONAL, MTMOT's own public-facing builds only. Never set on a client build.
# VITE_BRAND_IS_MTMOT=true
# VITE_BRAND_ADMIN_REDIRECT_URL=https://your-console.example.com

# ── Edge function secrets (`supabase secrets set KEY=value`) ─────────────────
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform; do not set them yourself.

# At least ONE of these three. The key must match the provider you use.
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...
# OPENAI_API_KEY=sk-...

# OPTIONAL. Deployment-wide default provider when an engagement has no
# st_ai_config row: anthropic | google | openai. Defaults to anthropic.
# LLM_PROVIDER=google
# OPTIONAL. Model to pair with LLM_PROVIDER (per-provider default if unset).
# LLM_MODEL=gemini-2.5-flash

# OPTIONAL. Intelligence Engine bolt-on for st-catalogue and st-generate-report.
# Unset = report grounding skipped and st-catalogue answers 503.
# NERA_ENGINE_URL=https://your-engine.example.com
# NERA_ENGINE_READ_KEY=...

# OPTIONAL, demo tier only. Redirect base for st-provision-* magic links.
# SITE_URL=https://strategy.example.com

# ── Scripts (local shell only) ────────────────────────────────────────────────
# scripts/seed-rural-futures-australia.ts (Carla's demo corpus; not for clients)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...

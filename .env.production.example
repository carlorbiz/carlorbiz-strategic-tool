# =============================================================================
# Strategy Engine — every variable the build and the edge functions read.
# CC-347 Slice 0b, item 8. Generated by grepping import.meta.env and
# Deno.env.get across client/src and supabase/functions.
#
# Every value below is EMPTY on purpose — this file is committed to the repo
# and must never carry a real secret, URL or key. Copy it, fill in real
# values in your own untracked .env / shell / `supabase secrets set` — never
# edit this file with real values and never commit that copy.
#
# Two groups: VITE_* are baked into the browser bundle at build time (public,
# never secrets — the anon key is public by design, everything else here is
# non-sensitive config). Everything else is an edge-function secret, set with
# `supabase secrets set KEY=value` (see CLIENT_RUNBOOK.md step 5). Nothing has
# a hard-coded fallback that points at anyone else's account: an unset
# optional value turns its feature off.
# =============================================================================

# ── Frontend (build-time, public; VITE_* only) ───────────────────────────────

# REQUIRED. Your Supabase project URL: Settings > API > Project URL.
VITE_SUPABASE_URL=

# REQUIRED. Your Supabase anon (publishable) key: Settings > API.
VITE_SUPABASE_ANON_KEY=

# OPTIONAL. Intelligence Engine bolt-on (Tools tab). Unset = tab hidden.
VITE_NERA_ENGINE_URL=

# OPTIONAL. Route engine reads through the st-catalogue function instead of
# calling VITE_NERA_ENGINE_URL directly (needed when the engine is
# key-gated). "true" also counts as "engine configured".
VITE_CATALOGUE_VIA_PROXY=

# OPTIONAL. Website-era general-site Nera chat endpoint; defaults to
# ${VITE_SUPABASE_URL}/functions/v1/nera-query when unset.
VITE_NERA_API_URL=

# OPTIONAL. Public bucket base for decision-tree screenshots; defaults to
# ${VITE_SUPABASE_URL}/storage/v1/object/public/content-images when unset.
VITE_CONTENT_IMAGES_BASE=

# ── Brand (client/src/lib/brand.ts) — all optional. MTMOT Strategy Engine
# defaults apply to any that are left empty; there is no host-based fallback.

# Product name shown in-app (onboarding copy, page titles).
VITE_BRAND_PRODUCT_NAME=

# Short name used where space is tight (nav, badges).
VITE_BRAND_SHORT_NAME=

# Browser tab <title>.
VITE_BRAND_TITLE=

# <meta name="description"> content.
VITE_BRAND_DESCRIPTION=

# Header logo asset path (under /public) or an absolute URL.
VITE_BRAND_LOGO=

# Accessible alt text for the logo; falls back to VITE_BRAND_PRODUCT_NAME.
VITE_BRAND_LOGO_ALT=

# Where the header logo links.
VITE_BRAND_HOME_URL=

# Single accent colour (hex), applied as --color-brand-accent at runtime.
VITE_BRAND_ACCENT_COLOR=

# Support contact shown in-app (onboarding copy).
VITE_BRAND_SUPPORT_EMAIL=

# OPTIONAL, MTMOT's own public-facing marketing/demo builds only. Never set
# this on a client build — "true" renders the replicated mtmot.com header
# and public product-page root route.
VITE_BRAND_IS_MTMOT=

# OPTIONAL, only meaningful with VITE_BRAND_IS_MTMOT=true. Where an
# admin/console route redirects to on that build; unset renders nothing
# rather than guessing a destination.
VITE_BRAND_ADMIN_REDIRECT_URL=

# ── Edge function secrets (`supabase secrets set KEY=value`) ─────────────────
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase platform for every edge function — do not set
# these yourself with `supabase secrets set`.

# At least ONE of these three, matching the client's LLM provider.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# OPTIONAL. Deployment-wide default provider when an engagement's
# st_ai_config row has no explicit provider: anthropic | google | openai.
LLM_PROVIDER=

# OPTIONAL. Model to pair with LLM_PROVIDER (each provider has its own
# built-in default model when this is unset).
LLM_MODEL=

# OPTIONAL. Intelligence Engine bolt-on, read by st-catalogue and
# st-generate-report. Unset = report grounding skipped and st-catalogue
# answers 503.
NERA_ENGINE_URL=
NERA_ENGINE_READ_KEY=

# OPTIONAL. Redirect base used by st-provision-campaign-user and
# st-provision-sandbox for their magic-link emails (demo/sandbox tiers only).
SITE_URL=

# ── Website-era functions still in this repo (not part of the engine's own
# 12 st-* functions, but present and readable — see below for env they need
# if they are deployed alongside the engine). ──────────────────────────────

# OPTIONAL, read by notify-follow-up and generate-insights.
CLIENT_NAME=

# OPTIONAL, read by notify-follow-up.
ADMIN_NOTIFICATION_EMAIL=
N8N_FOLLOW_UP_WEBHOOK=

# ── Scripts (local shell only, never deployed) ───────────────────────────────
# scripts/seed-rural-futures-australia.ts (Carla's demo corpus; not for clients)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
